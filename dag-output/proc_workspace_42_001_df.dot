digraph "dag_42_simple_0_data_flow" {
  rankdir=TB;
  node [fontname="Helvetica" fontsize=10];
  edge [fontname="Helvetica" fontsize=8];

  "df_tout_1" [shape=box style="filled,rounded" fillcolor="#E3F2FD" label="check_free_slots.read_data [TOOL]"];
  "df_tout_2" [shape=box style="filled,rounded" fillcolor="#E3F2FD" label="dispatch_email.write_result [TOOL]"];
  "df_pval_3" [shape=note style=filled fillcolor="#E8F5E9" label="PROMPT\navailability_attendees: "];
  "df_pval_4" [shape=note style=filled fillcolor="#E8F5E9" label="PROMPT\navailability_date: "];
  "df_tin_5" [shape=box style=filled fillcolor="#FFF3E0" label="dispatch_email.input"];
  "df_tin_6" [shape=box style=filled fillcolor="#FFF3E0" label="check_free_slots.availability_attendees"];
  "df_tin_7" [shape=box style=filled fillcolor="#FFF3E0" label="check_free_slots.availability_date"];

  "df_tout_1" -> "df_tin_5" [color="#1565C0" style=solid label="modify_data [TOOL_OUTPUT]"];
  "df_pval_3" -> "df_tin_6" [color="#1565C0" style=solid label="availability_attendees -> availability_attendees [PROMPT]"];
  "df_pval_4" -> "df_tin_7" [color="#1565C0" style=solid label="availability_date -> availability_date [PROMPT]"];
}