digraph "dag_42_medium_1_data_flow" {
  rankdir=TB;
  node [fontname="Helvetica" fontsize=10];
  edge [fontname="Helvetica" fontsize=8];

  "df_tout_1" [shape=box style="filled,rounded" fillcolor="#E3F2FD" label="search_calendar.search_results [TOOL]"];
  "df_tout_2" [shape=box style="filled,rounded" fillcolor="#E3F2FD" label="get_contact.detail [TOOL]"];
  "df_tout_3" [shape=box style="filled,rounded" fillcolor="#E3F2FD" label="slack_message.action_result [TOOL]"];
